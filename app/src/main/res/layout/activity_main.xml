<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="100"
    android:background="#121418">

    <!-- 70% Google Filament AAA PBR Viewport -->
    <FrameLayout
        android:id="@+id/viewport_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="70">

        <android.view.SurfaceView
            android:id="@+id/filament_surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tv_pbr_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:text="✨ Google Filament PBR Engine Активен"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#88000000"
            android:padding="6dp"/>
    </FrameLayout>

    <!-- 30% Чат конзола -->
    <LinearLayout
        android:id="@+id/chat_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30"
        android:orientation="vertical"
        android:background="#1A1C22">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:clipToPadding="false"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="#24262E"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_ai_cloud"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="☁️ AI"
                android:textSize="12sp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"/>

            <EditText
                android:id="@+id/chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Въведи команда..."
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent"
                android:padding="6dp"
                android:textSize="13sp"
                android:inputType="textMultiLine"
                android:maxLines="2"/>

            <Button
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Прати"
                android:textSize="12sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
