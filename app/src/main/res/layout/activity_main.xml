<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="100"
    android:background="#141416">

    <!-- 70% 3D VIEWPORT -->
    <FrameLayout
        android:id="@+id/viewport_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="70">

        <android.opengl.GLSurfaceView
            android:id="@+id/gl_surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- HUD: Точки и цел на играта -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="top|start"
            android:layout_margin="12dp">

            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💎 Точки: 0"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="#88000000"
                android:padding="6dp"/>

            <TextView
                android:id="@+id/tv_game_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Опиши игра в чата, за да я генерирам!"
                android:textColor="#00FFCC"
                android:textSize="12sp"
                android:background="#88000000"
                android:padding="6dp"/>
        </LinearLayout>

        <!-- Банер за победа -->
        <TextView
            android:id="@+id/tv_win_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🏆 ПОБЕДА! 🏆"
            android:textColor="#FFEB3B"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="#DD000000"
            android:padding="16dp"
            android:visibility="gone"/>

        <!-- Джойстик долу вляво -->
        <com.aigame.engine.JoystickView
            android:id="@+id/joystick_view"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="24dp" />
    </FrameLayout>

    <!-- 30% КОНЗОЛА ЗА СЪЗДАВАНЕ НА ИГРИ -->
    <LinearLayout
        android:id="@+id/chat_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="30"
        android:orientation="vertical"
        android:background="#1B1B1E">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:clipToPadding="false"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="#242428"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_ai_cloud"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="☁️ AI"
                android:textSize="12sp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"/>

            <EditText
                android:id="@+id/chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Опиши игра..."
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent"
                android:padding="6dp"
                android:textSize="13sp"
                android:inputType="textMultiLine"
                android:maxLines="2"/>

            <Button
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Създай"
                android:textSize="12sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
